tellraw @s ["- ",{text:"/trigger tpr set #",color:"gold",hover_event:{action:"show_text",value:["",{text:"/trigger tpr set #",color:"green"},{text:"\nTeleport to players or accept/deny their requests."},{text:"\n\nPositive Values",color:"gold",},{text:" - Send a teleport request to #"},{text:"\nNegative Values",color:"gold",},{text:" - Accept a request from #"},{text:"\n"},{score:{name:"@s",objective:"se.uid"},color:"gold",},{text:" - Cancel your request"},{text:"\n\nExamples:",color:"gold"},{text:"\n/trigger tpr set 2",color:"gray"},{text:" - Send a request to player with uid 2, unless your UID is 2"},{text:"\n/trigger tpr set -5",color:"gray"},{text:" - Accept player with uid 5's request, unless your UID is 5"}]},click_event:{action:"suggest_command",command:"/trigger tpr set"}}]
