tellraw @s ["- ",{text:"/trigger list set #",color:"gold",hover_event:{action:"show_text",value:["",{text:"/trigger list set #",color:"green"},{text:"\nList players and their UID"},{text:"\n\nPositive Values",color:"gold",},{text:" - List all players online"},{text:"\nNegative Values",color:"gold",},{text:" - List player UIDs by page, see page #"},{text:"\n"},{text:"\n\nExamples:",color:"gold"},{text:"\n/trigger list set -1",color:"gray"},{text:" - See who has UIDs 1-10"},{text:"\n/trigger list set 1",color:"gray"},{text:" - See online player UIDs"}]},click_event:{action:"suggest_command",command:"/trigger list set "}}]


